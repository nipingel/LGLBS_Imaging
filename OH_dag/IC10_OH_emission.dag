#!/usr/bin/env IC10_OH_emission.dag

## IMAGING
## run tclean to imagine single channels
## executable:
## - image_channel.sh (runs image_channel.py)
## inputs:
## - ms_name: concatenated measurement set (without channel number ID, to be appended in execution script)
## - ra_phase_center: ra coordinate string to set phase center
## - dec_phase_center: dec coordinate string to set phase center
## - src_name: source name
## output:
## - tarball containing tclean output for single spectral channels
JOB L image_channel.sub
VARS L ms_name="ic10ctr_A+B+C+D_oh1720.ms" src_name="ic10ctr" ra_phase_center="00h20m17.2917s" dec_phase_center="59d18m13.867s"
## PARENT K CHILD 

## RESTART IMAGING
## run tclean to imagine single channels
## executable:
## - image_channel.sh (runs image_channel.py)
## inputs:
## - ms_name: concatenated measurement set (without channel number ID, to be appended in execution script)
## - ra_phase_center: ra coordinate string to set phase center
## - dec_phase_center: dec coordinate string to set phase center
## - src_name: source name
## output:
## - tarball containing tclean output for single spectral channels
## JOB K restart_image_channel.sub
## VARS K ms_name="NGC6822_A+B+C+D.comb_spw.wt" src_name="NGC6822" ra_phase_center="19h44m57.74s" dec_phase_center="-14d48m12.4"
## PARENT K CHILD L

## UNTAR FOR COMBINATION
## untar and move back desired output images to staging area for combination
## executable:
## - untar_images.sh (runs untar_images.sh)
## inputs:
## - suffix: CASA file suffix to move back to staging (e.g., image, image.pbcor, residual, etc.)
## - src_name: source_name
## - file_name: root name of files
## output:
## - extracted CASA image file in staging area
## JOB L untar_images.sub
## VARS L suffix="image.pbcor" src_name="M33" root_file_name="M33_A+B+C+D.ms.wt"
## PARENT L CHILD M

## COMBINE IMAGES
## finally, combine the 2D images into 3-dimensional data cube (dims: sky position, sky position, frequency/velocity)
## executable:
## - fitsconcat.sh (runs fitsconcat.py)
## inputs:
## - suffix: combine all files with *.suffix
## - output_name: name of output data cube (in FITS format)
## - src_name: source name
## - delta_nu: spectral width of channels in kHz
## output:
## - final data cube
## JOB M fitsconcat.sub
## VARS M suffix="image.pbcor.fits" src_name="M33" output_name="M33_ABCD"
## PARENT M CHILD N

## PREP UVCOMBINE 
## feather images in Fourier space with uvcombine python package
## executable:
## - prep_feather_cubes.sh
## inputs:
## - src_name: source name for directory path
## - sdcube: name of lowres cube
## - interfcube: name of highres cube
## - feathercube: name of feather cube
## JOB N prep_feather_cubes.sub
## VARS N src_name="M33" sdcube="m33_gbt_vlsr.fits" interfcube="M33_ABCD.fits" feathercube="M33_ABCD_feathered.fits"
## PARENT N CHILD O

## UVCOMBINE (DISTRIBUTED)
## feather images in Fourier space with uvcombine python package
## executable:
## - feather_cubes.sh
## inputs:
## - src_name: source name for directory path
## - sdcube: name of lowres cube
## - interfcube: name of highres cube
## - outpath: output path/filename
## - galaxy: name of galaxy
## JOB O feather_cubes_distributed.sub
## VARS O src_name="M33" sdcube="m33_gbt_vlsr_specinterp.fits" interfcube="M33_ABCD.fits" galaxy="m33"
